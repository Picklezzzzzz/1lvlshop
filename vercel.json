{
  "rewrites": [
    { "source": "/api/products", "destination": "/data/catalog.json" }
  ],
  "redirects": [
    { "source": "/admin.html", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/data/catalog.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    }
  ]
}
